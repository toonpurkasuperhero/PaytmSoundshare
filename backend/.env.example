# Copy to .env and fill in. NEVER commit .env.

# --- Admin account (created on first start if it doesn't exist) ---
ADMIN_PHONE=
ADMIN_PASSWORD=

# Where devices (ESP32) reach this server: your laptop's LAN IP, not localhost.
# Leave empty to auto-detect (may pick a virtual adapter).
PUBLIC_BASE_URL=

# --- Google Gemini: PRIMARY path for ad copy, ad voice, bill parsing & bill division ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_VOICE=Kore
# Voice fallback used ONLY if Gemini TTS fails: edge | none
TTS_FALLBACK=edge

# --- Payments: mock (test mode, no real money) | paytm | razorpay ---
PAYMENT_PROVIDER=mock

PAYTM_MID=
PAYTM_MERCHANT_KEY=
PAYTM_BASE_URL=https://securegw-stage.paytm.in
PAYTM_CLIENT_ID=C11
PAYTM_STORE_ID=STORE1

# Razorpay (test keys start with rzp_test_)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# payment_link (works in test mode) | upi_qr (live UPI QR)
RAZORPAY_MODE=payment_link

DATABASE_URL=sqlite:///./zeromdr.db

# --- Sarvam AI: Indian-language voices (payment announcements + ads in 11 languages) ---
SARVAM_API_KEY=
# Which AI voices ads first: sarvam | gemini (the other is the AI backup)
AD_VOICE_PRIMARY=sarvam
